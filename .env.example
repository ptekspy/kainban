# Local development uses .env.local
# Production uses .env

POSTGRES_DB=kainban
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kainban
WORKSPACE_ROOT=/tmp/kainban-workspaces

NEXT_PUBLIC_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_APP_ENV=development
BETTER_AUTH_URL=http://localhost:4001
BETTER_AUTH_SECRET=replace-with-a-secure-secret
ADMIN_EMAIL=admin@kainban.dev
ADMIN_PASSWORD=ChangeMe123!

# Optional worker configuration
DEV_WORKER_ID=dev-worker-1
OLLAMA_QUEUE_CONCURRENCY=1
DEV_WORKER_ARTIFACT_RELATIVE_PATH=.dev-worker/execution-note.md
# DEV_WORKER_TEST_COMMAND=pnpm test

# Optional single-worker Ollama fallback
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:14b
# OLLAMA_KEEP_ALIVE=15m
# OLLAMA_REQUEST_TIMEOUT_MS=120000
# OLLAMA_HEADERS={"authorization":"Bearer example"}
# OLLAMA_OPTIONS={"temperature":0.1,"num_ctx":16384}

# Optional multi-worker Ollama config
# DEV_WORKER_OLLAMA_CONFIGS={"dev-worker-1":{"baseUrl":"http://127.0.0.1:11434","model":"qwen2.5-coder:14b","keepAlive":"15m","options":{"temperature":0.1}},"dev-worker-2":{"baseUrl":"http://127.0.0.1:22434","model":"llama3.1:8b","requestTimeoutMs":90000,"options":{"temperature":0.2}}}

# Optional Playwright GitHub fixtures
E2E_PUBLIC_GITHUB_REPO_URL=https://github.com/octocat/Hello-World
E2E_PRIVATE_GITHUB_REPO_URL=
E2E_GITHUB_PAT=
